  "originalProgramEvidence": {
    "logicalBase": "0x7000f000",
    "byteReader": "0x00051004..0x00051028 doubles the logical byte address, reads a reversed word and masks one 8-bit lane.",
    "byteWriter": "0x00051104..0x00051130 reads the reversed word, replaces one 8-bit lane and writes that word back, preserving all other lanes.",
    "P1CreditPath": "0x0004e260..0x0004e29c updates logical 0x22.",
    "P2CreditPath": "0x0004e330..0x0004e35c updates logical 0x25.",
    "conversionRemainders": "0x0004e2a0..0x0004e2f0 computes a division remainder into logical 0x23; 0x0004dfcc..0x0004e164 performs normal/bonus conversions, including logical 0x24/0x26/0x27. These are transient credit conversion state, not the accounting totals.",
    "originalBoot": "0x0004db14 loads P2 credit; initialization independently clears all four conversion remainders. Thus only the two bank bytes persist into the next original boot, while all six are explicitly zeroed by the host before it creates the engine.",
    "checksum": "No credit checksum or paired credit copy is needed: exact narrow cleared inputs load byte-for-byte at the first reference frame and reach attract with all other cabinet state intact.",
    "observationScope": "An isolated copy of the pinned original PPC executor records read-only bus writes; it is never linked into the native product. Instruction disassembly and raw traces stay in ignored build/startup-investigation."
